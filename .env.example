# Local-only development credentials. Set a secret URL on the hosting platform.
DATABASE_URL=postgresql://business_card:local_dev_password@localhost:5433/business_card?schema=public
PORT=3000
NODE_ENV=development
LOG_LEVEL=info
DEMO_SANDBOX=true
RATE_LIMIT_MAX=120
# Number of trusted reverse-proxy hops. Keep 0 for direct local access.
TRUST_PROXY_HOPS=0
