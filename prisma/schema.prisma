generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model Profile {
  id          String        @id
  name        String
  headline    String
  description String
  links       ProfileLink[]
  skills      Skill[]
  experience  Experience[]
  projects    Project[]
}

model ProfileLink {
  id        String  @id
  profileId String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  label     String
  url       String
  sortOrder Int

  @@unique([profileId, url])
  @@index([profileId, sortOrder])
}

model Skill {
  id        String         @id
  profileId String
  profile   Profile        @relation(fields: [profileId], references: [id], onDelete: Cascade)
  name      String
  category  String
  sortOrder Int
  projects  ProjectSkill[]

  @@unique([profileId, name])
  @@index([profileId, sortOrder])
}

model Experience {
  id           String   @id
  profileId    String
  profile      Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  company      String
  position     String
  startMonth   String   @db.VarChar(7)
  endMonth     String?  @db.VarChar(7)
  description  String
  achievements String[]

  @@index([profileId, startMonth(sort: Desc)])
}

model Project {
  id           String         @id
  profileId    String
  profile      Profile        @relation(fields: [profileId], references: [id], onDelete: Cascade)
  name         String
  description  String
  contribution String
  url          String
  sortOrder    Int
  skills       ProjectSkill[]

  @@index([profileId, sortOrder])
}

model ProjectSkill {
  projectId String
  skillId   String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  skill     Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([projectId, skillId])
  @@index([skillId])
}
